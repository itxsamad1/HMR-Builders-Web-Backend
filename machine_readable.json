  "raw_schema_tree": {
    "neondb.public": {
      "tables": {
        "users": {
          "columns": ["id", "email", "name", "first_name", "last_name", "phone", "kyc_status", "is_active", "role", "investment_profile", "kyc_documents"],
          "indexes": ["users_pkey", "users_email_key", "idx_users_email", "idx_users_kyc_status", "idx_users_status", "idx_users_role"],
          "constraints": ["users_role_check", "users_kyc_status_check", "users_status_check"]
        },
        "user_wallets": {
          "columns": ["id", "user_id", "total_balance", "available_balance", "locked_balance", "total_tokens", "total_investment", "total_returns"],
          "indexes": ["user_wallets_pkey", "idx_user_wallets_user_id"],
          "constraints": ["user_wallets_user_id_fkey"]
        },
        "wallet_transactions": {
          "columns": ["id", "user_id", "payment_method_id", "transaction_type", "amount", "currency", "exchange_rate", "amount_in_pkr", "status", "description", "metadata"],
          "indexes": ["wallet_transactions_pkey", "idx_wallet_transactions_user_id", "idx_wallet_transactions_type", "idx_wallet_transactions_status"],
          "constraints": ["wallet_transactions_transaction_type_check", "wallet_transactions_status_check", "wallet_transactions_user_id_fkey"]
        },
        "properties": {
          "columns": ["id", "title", "slug", "description", "property_type", "status", "pricing_total_value", "pricing_expected_roi", "tokenization_total_tokens", "tokenization_available_tokens", "location_city", "is_active", "is_featured"],
          "indexes": ["properties_pkey", "properties_slug_key", "idx_properties_slug", "idx_properties_status", "idx_properties_is_active", "idx_properties_is_featured"],
          "constraints": ["properties_status_check", "properties_property_type_check"]
        },
        "investments": {
          "columns": ["id", "user_id", "property_id", "investment_amount", "tokens_purchased", "price_per_token", "status", "payment_status"],
          "indexes": ["investments_pkey", "idx_investments_user_id", "idx_investments_property_id", "idx_investments_status", "idx_investments_payment_status"],
          "constraints": ["investments_user_id_fkey", "investments_property_id_fkey"]
        },
        "payment_methods": {
          "columns": ["id", "user_id", "card_type", "card_number_masked", "card_holder_name", "billing_address", "currency", "is_default", "is_verified", "status"],
          "indexes": ["payment_methods_pkey", "idx_payment_methods_user_id", "idx_payment_methods_card_type", "idx_payment_methods_is_default"],
          "constraints": ["payment_methods_user_id_fkey", "payment_methods_card_type_check"]
        }
